---
# Tópico Principal
apiVersion: pubsub.gcp.m.upbound.io/v1beta1
kind: Topic
metadata:
  name: devops-topic
  labels:
    team: guests
    env: stage
    resource-name: devops-topic
spec:
  forProvider: {}
  providerConfigRef:
    name: default

---
# Subscription Principal
apiVersion: pubsub.gcp.m.upbound.io/v1beta1
kind: Subscription
metadata:
  name: devops-topic
spec:
  forProvider:
    topicSelector:
      matchLabels:
        resource-name: devops-topic
    ackDeadlineSeconds: 20
    
  providerConfigRef:
    name: default

